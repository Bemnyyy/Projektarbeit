      "text/plain": [
       "<Figure size 800x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Nur Werktage (Mo–Fr)\n",
    "commuter = merged[merged['day_type'] == 'Werktag'].copy()\n",
    "\n",
    "commuter_profile = (\n",
    "    commuter.groupby('hour')['rent_rate']\n",
    "    .mean()\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "\n",
    "ax.plot(\n",
    "    commuter_profile['hour'],\n",
    "    commuter_profile['rent_rate'],\n",
    "    marker='o'\n",
    ")\n",
    "\n",
    "ax.set_xlabel('Uhrzeit')\n",
    "ax.set_ylabel('mittlere Ausleihquote')\n",
    "ax.set_title('Pendlerprofil (nur Werktage, gesamter Zeitraum)')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "44125b23",
   "metadata": {},
   "source": [
    "##### In diesem Plot wird zuerst für die Werktage über den gesamten Zeitraum des Datensatzes ein Profil für das Ausleihverhalten erstellt. Zu sehen ist eine Kurve die das ähnliche darstellt wie die anderen Plots bisher. Ein Start der Ausleihereignisse ab 4 Uhr morgens bis 6 Uhr, danach ein Abfall bis 9 Uhr und darauf folgend ein weiterer Anstieg bis 10 Uhr. Folgend ein weiterer Abfall der Rate bis 13 Uhr, ein weiterer Aufstieg folgend bis 15 Uhr und ab 16 Uhr ein Abstieg der Quote bis 23 Uhr.\n",
    "##### Dies alles lässt darauf zurückschließen das an Werktagen die NextBikes hauptsächlich für den Weg zur und von der Arbeit aber auch für die Pausenstunden zwischen 10 und 11 Uhr benutzt werden."
   ]
  },

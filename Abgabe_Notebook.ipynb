   ],
   "source": [
    "# Oberen Grenzwert setzen -> alles über 0.3 ignorieren\n",
    "threshold = 0.3\n",
    "warm_week_plot = warm_week[warm_week[\"rent_rate\"] <= threshold].copy()\n",
    "\n",
